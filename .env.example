# 复制为 .env 并填入真实值。.env 不进 git。
# GLM API key（智谱开放平台）。不配置时所有 AI 功能自动隐藏，主流程不受影响。
AI_API_KEY=
# 端点二选一：Coding Plan 套餐 key 用第一行；按量付费标准 key 用第二行
AI_BASE_URL=https://open.bigmodel.cn/api/coding/paas/v4
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
AI_MODEL=glm-5.3-flash

# 服务端口
PORT=3000
# 数据目录（app.db + uploads/），默认项目下 data/
# DATA_DIR=/var/lib/idle-planet
# HTTPS 部署时设为 true
COOKIE_SECURE=false
# 启动时自动创建的管理员工号/姓名
ADMIN_EMPLOYEE_NO=A001
ADMIN_NAME=管理员
